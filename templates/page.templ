package templates

templ Page() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Péter Szarvas. From systems administration to full-stack development. Building simple software that works."/>
			<title>Péter Szarvas</title>
			<meta name="color-scheme" content="light"/>
			<link rel="canonical" href="https://peterszarvas.hu/"/>
			<link rel="icon" href="/favicon.ico" sizes="32x32"/>
			<link rel="icon" type="image/svg+xml" href={ templ.SafeURL(faviconHref()) }/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content="https://peterszarvas.hu/"/>
			<meta property="og:title" content="Péter Szarvas"/>
			<meta property="og:description" content="I build software."/>
			<meta property="og:image" content="https://peterszarvas.hu/static/brand/og.png"/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content="Péter Szarvas: I build software."/>
			<meta name="twitter:card" content="summary_large_image"/>
			<link rel="preload" href="/static/fonts/IBMPlexMono-Regular.ttf" as="font" type="font/ttf" crossorigin/>
			<link rel="stylesheet" href={ templ.SafeURL(Stylesheet) }/>
			<script type="module" src={ Script }></script>
		</head>
		<body>
			<a class="skip-link" href="#content">Skip to content</a>
			<nav class="page-nav" aria-label="Resume">
				<div class="resume-actions">
					<a class="btn btn-amber" href="/resume.pdf" download="Peter-Szarvas-resume.pdf">Save resume <span aria-hidden="true">↓</span></a>
					<button type="button" class="btn" onclick="document.fonts.ready.then(() => window.print())">Print resume</button>
				</div>
				<button type="button" class="btn sheet-toggle" aria-controls="typesheet" aria-expanded="false">
					<span class="lamp" aria-hidden="true"></span>Spec sheet
				</button>
			</nav>
			<main id="content" class="paper">
				<header class="identity">
					<h1>Péter Szarvas</h1>
					<p class="intro">I build software.</p>
					<address>
						<a href="mailto:contact@peterszarvas.hu">contact@peterszarvas.hu</a>
						<a href="https://github.com/peterszarvas94">github.com/peterszarvas94</a>
						<a href="https://www.linkedin.com/in/peterszarvas94/">linkedin.com/in/peterszarvas94</a>
					</address>
				</header>
				@Career()
				<div class="home-extra">
					<section class="lore" aria-labelledby="lore-heading">
						<h2 id="lore-heading">A little more of the story</h2>
						<p>I started with servers, moved into applications, and kept wanting to understand the whole thing. These days that means building the interface, writing the backend, and keeping it running.</p>
						<p>I like simple code and small tools. Go, server-rendered HTML, and fewer moving parts when they do the job. React and TypeScript when they fit.</p>
						<p>Bandcash brings that thinking to the world of music bands: less time untangling who owes what, more time for the music.</p>
						<p>On my reading list:</p>
						<ul class="reading-list">
							<li><a href="https://hypermedia.systems/">Hypermedia Systems</a></li>
							<li><a href="https://grugbrain.dev/">The Grug Brained Developer</a></li>
							<li><a href="https://www.oreilly.com/library/view/we-programmers-a/9780135344248/">We, Programmers</a></li>
							<li><a href="https://basecamp.com/books#rework">Rework</a></li>
						</ul>
					</section>
					<footer><p>Have something in mind? <a class="btn btn-green" href="mailto:contact@peterszarvas.hu">Let's talk</a></p></footer>
				</div>
			</main>
			@TypeSheet()
		</body>
	</html>
}

templ Arrow() {
	<span class="arrow" aria-hidden="true">
		<svg viewBox="0 0 10 6" fill="none"><path d="M1 1 L5 5 L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
	</span>
}

templ Career() {
	<ol class="career" aria-label="My path">
		<li class="stage">
			<h2>System administrator</h2>
			<div class="stage-body">
				@Arrow()
				<div class="jobs">
					<section class="job" aria-labelledby="ibm-heading">
						<header class="job-head"><h3 id="ibm-heading">IBM / Kyndryl</h3><p class="dates"><time datetime="2020">2020</time>–<time datetime="2022">2022</time></p></header>
						<ul><li>Deployed and managed Windows servers in hybrid Microsoft Azure environments.</li></ul>
					</section>
				</div>
			</div>
		</li>
		<li class="stage">
			<h2>Fullstack developer</h2>
			<div class="stage-body">
				@Arrow()
				<div class="jobs">
					<section class="job" aria-labelledby="kyndryl-heading">
						<header class="job-head"><h3 id="kyndryl-heading">Kyndryl</h3><p class="dates"><time datetime="2022">2022</time>–<time datetime="2024">2024</time></p></header>
						<ul><li>Maintained an internal business lead tracker in a two-person team.</li><li>React and JavaScript.</li></ul>
					</section>
					<section class="job" aria-labelledby="eviden-heading">
						<header class="job-head"><h3 id="eviden-heading">Eviden / Atos</h3><p class="dates"><time datetime="2024">2024</time>–present</p></header>
						<ul><li>Building a government application in an international team.</li><li>React, TypeScript, Node.js and NestJS.</li></ul>
					</section>
				</div>
			</div>
		</li>
		<li class="stage">
			<h2>Agentic programmer / designer / devops</h2>
			<div class="stage-body">
				@Arrow()
				<div class="jobs projects">
					<section class="job" aria-labelledby="bandcash-heading">
						<header class="job-head"><h3 id="bandcash-heading">Bandcash</h3><a class="site" href="https://bandcash.app">bandcash.app</a></header>
						<ul><li>Building and operating a payment splitting app for music bands.</li><li>Go, templ, Datastar, SQLite.</li></ul>
					</section>
					<section class="job" aria-labelledby="pongrac-heading">
						<header class="job-head"><h3 id="pongrac-heading">Szarvas Pongrác</h3><a class="site" href="https://szarvaspongrac.hu">szarvaspongrac.hu</a></header>
						<ul><li>An artist's portfolio.</li></ul>
					</section>
					<section class="job" aria-labelledby="szeremle-heading">
						<header class="job-head"><h3 id="szeremle-heading">Szeremle Tánc</h3><a class="site" href="https://szeremletanc.hu">szeremletanc.hu</a></header>
						<ul><li>A page for a folk dance group.</li></ul>
					</section>
					<section class="job" aria-labelledby="pantlika-heading">
						<header class="job-head"><h3 id="pantlika-heading">Pántlika Zenekar</h3><a class="site" href="https://pantlikazenekar.hu">pantlikazenekar.hu</a></header>
						<ul><li>A website for a folk music band.</li></ul>
					</section>
					<section class="job" aria-labelledby="wedding-heading">
						<header class="job-head"><h3 id="wedding-heading">Wedding invitation</h3><a class="site" href="https://wedding.peterszarvas.hu">wedding.peterszarvas.hu</a></header>
						<ul><li>A small website for a big day.</li></ul>
					</section>
					<div class="job next"><p><a class="btn btn-amber" href="mailto:contact@peterszarvas.hu">Your project?</a></p><ul><li>Something useful, built together.</li></ul></div>
				</div>
			</div>
		</li>
	</ol>
}
